  "content": "[Intro]\n[F]\n[C]\n[F]\n[C]\n[D/F#]\n[E]\n[F]\n[C]\n[F]\n[C]\n[F]\n[C]\n[E]\n[F]\n[G]  [F]\n\n[Verse]\n[C]Tactful cac tus by your\n[F]window,\n[C]Surveys the prairie of your\n[F]room,\n[C]the mobile spins to its\n[D/F#]collision,\n[E]Clara puts her head between her\n[F]paws.\n[C]They've opened shops down on the\n[F]West side,\n[C]will all the cacti find a\n[F]home?\n[C]But the key to the\n[E]city Is in the\n[F]sun that pins the branches To the\n[G]sky, [F]oh.\n\n[Outro]\n[C]\n[F]\n[C]\n[F]\n[C]\n[F]\n[C]\n[F]\n[C]",
